# Dependencies
node_modules/
steve-desktop/node_modules/

# Build output
steve-desktop/dist/
steve-desktop/src-tauri/target/

# Tauri generated
steve-desktop/src-tauri/gen/

# Bun
*.lockb

# Agent memory
.agents/memory/lightrag_workdir/
.agents/memory/.venv/

# Captured site profiles — LOCAL working artifacts that contain raw page text
# (rosters, message senders → student names / PII). Never commit these.
.agents/site-profiles/
# Archived copies of the above — same real student data, keep local only.
.agents/site-profiles-archive/

# Local spikes (throwaway experiments + their virtualenvs)
spikes/
**/.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Sisyphus evidence (large, regenerable)
.sisyphus/evidence/

# Git worktrees (per-island integration branches live here)
.worktrees/

# Environment
.env
.env.local

# Local capture artifacts (upstream demo clips, run recordings)
*.mp4
graphify-out/

# Cross-CLI message log. Only the cursor-<agent> files are local state: they are per-machine
# READ POSITIONS, so a committed cursor makes another checkout skip messages it never saw.
# log.jsonl and FUTURE.md are meant to ship with the repo, so scope the ignore to the cursors.
.msgbox/cursor-*

# Verification screenshots dropped by agent runs. A spec that names a scratchpad path is
# sometimes ignored in favour of writing into the repo, so this catches the artifact rather
# than relying on every run getting the path right.
steve-desktop/.agents/evidence/

# Agent working files. Runs drop CDP helpers, temp JSON and verification
# screenshots here; none of it is source.
steve-desktop/scratchpad/

# playwright-cli run artifacts (snapshots, console logs, screenshots). Written
# into whatever directory a command runs from; never source.
.playwright-cli/

# _push audit output — regenerated by qtext-audit.mjs / anstypes-audit.mjs on every
# run. They land beside the repo root the scripts resolve, not inside mom-content,
# so both paths are listed.
steve-desktop/mom-content/qtext-audit.json
steve-desktop/mom-content/anstypes-audit.json
steve-desktop/qtext-audit.json
steve-desktop/anstypes-audit.json

# site-profile.mjs's selector-recipe cache. Same category as .agents/site-profiles/ above --
# captured page content from live sites (SafeColleges training pages, MyOpenMath course pages)
# that can carry real student names. Regenerable, and never meant to ship with the repo.
scripts/_profile/

# One-off scratch scripts dropped at the repo root during a session. Real tools live under
# scripts/ or mom-content/_push/ with a name that says what they do; anything still prefixed
# scratch- when the session ends was throwaway.
steve-desktop/scratch-*.mjs
