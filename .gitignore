# Dependencies
node_modules/
steve-desktop/node_modules/

# Build output
steve-desktop/dist/
steve-desktop/src-tauri/target/

# Tauri generated
steve-desktop/src-tauri/gen/

# Bun
*.lockb

# Agent memory
.agents/memory/lightrag_workdir/
.agents/memory/.venv/

# Captured site profiles — LOCAL working artifacts that contain raw page text
# (rosters, message senders → student names / PII). Never commit these.
.agents/site-profiles/
# Archived copies of the above — same real student data, keep local only.
.agents/site-profiles-archive/

# Local spikes (throwaway experiments + their virtualenvs)
spikes/
**/.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Sisyphus evidence (large, regenerable)
.sisyphus/evidence/

# Git worktrees (per-island integration branches live here)
.worktrees/

# Environment
.env
.env.local

# Local capture artifacts (upstream demo clips, run recordings)
*.mp4
graphify-out/

# Cross-CLI message log. Local coordination state, not source: cursor-<agent> files are
# per-machine READ POSITIONS, so a committed cursor makes another checkout skip messages
# it never saw. agent-evo ignores it for the same reason.
.msgbox/
