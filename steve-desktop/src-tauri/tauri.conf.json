{
  "productName": "S.T.E.V.E Desktop",
  "version": "0.1.0",
  "identifier": "com.steve.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "S.T.E.V.E - Sitting Through Every Video Entirely",
        "width": 1280,
        "height": 900
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
